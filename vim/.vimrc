" --- Leader keys
let mapleader = ' '
let maplocalleader = ' '

" --- Keymaps
nnoremap <Esc> <cmd>nohlsearch<CR>
nnoremap <C-h> <C-w><C-h>
nnoremap <C-l> <C-w><C-l>
nnoremap <C-j> <C-w><C-j>
nnoremap <C-k> <C-w><C-k>
nnoremap <leader>q :lopen<CR>

" --- Options
set number
set relativenumber
set mouse=a
set ignorecase
set smartcase
set signcolumn=yes
set updatetime=250
set timeoutlen=300
set splitright
set splitbelow
set scrolloff=10
set confirm
set noshowmode
set breakindent
set undofile
set incsearch
set hlsearch
set shiftwidth=4
set tabstop=4
set clipboard=unnamedplus
